# Local Postgres (Docker: docker compose up -d)
DATABASE_URL="postgresql://hamzury:hamzury@localhost:5432/hamzury?schema=public"
DIRECT_URL="postgresql://hamzury:hamzury@localhost:5432/hamzury?schema=public"

# Neon on Vercel — use both strings from the Neon dashboard:
#   DATABASE_URL  = pooled  (hostname contains -pooler)
#   DIRECT_URL    = direct  (no -pooler). Neon’s Vercel integration
#                   calls this DATABASE_URL_UNPOOLED — copy that value here.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

ADMIN_PASSWORD="change-me"
ADMIN_SECRET="generate-a-long-random-string"

# Vercel Blob (private store). Connecting a Blob store to the Vercel project
# sets BLOB_READ_WRITE_TOKEN automatically. Needed locally only if you want
# to exercise Blob instead of the uploads/ folder.
# BLOB_READ_WRITE_TOKEN=""
