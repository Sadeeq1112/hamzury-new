generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentType {
  APPLICATION_FEE
  PROGRAMME_FEE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EnquiryKind {
  PARTNER
  SPONSOR
}

model Application {
  id              String            @id @default(cuid())
  ref             String            @unique
  status          ApplicationStatus @default(PENDING)

  name            String
  email           String
  phone           String
  location        String
  gender          String?
  state           String?
  occupation      String?
  education       String?
  heardAbout      String?

  route           String
  track           String?
  programmeLabel  String?
  programmeFee    Int?
  siwes           String?
  level           String?
  age             String?
  guess           String?

  dob             String?
  school          String?
  cls             String?
  interests       String?
  guardianName    String?
  guardianRel     String?
  guardianPhone   String?
  guardianEmail   String?
  emergency       String?
  consent         Boolean?

  notes           String?
  submittedAt     DateTime          @default(now())
  verifiedAt      DateTime?

  payments        Payment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          PaymentType
  amount        Int
  status        PaymentStatus @default(PENDING)
  receiptPath   String?
  receiptName   String?
  receiptMime   String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([applicationId])
}

model Enquiry {
  id        String      @id @default(cuid())
  kind      EnquiryKind
  org       String
  orgType   String?
  contact   String?
  phone     String
  email     String?
  does      String?
  why       String?
  bring     String?
  want      String?
  outcome   String?
  area      String?
  support   String?
  report    String?
  notes     String?
  createdAt DateTime    @default(now())

  @@index([kind])
  @@index([createdAt])
}
